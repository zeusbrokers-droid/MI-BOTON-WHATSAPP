{
  "name": "leslie-car-agent",
  "version": "1.3.0",
  "private": true,
  "main": "electron-main.js",
  "description": "Agente local de WhatsApp para captar y calificar prospectos de Leslie Car Miami",
  "author": "Zeus Brokers",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "test": "node --test",
    "build:windows": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.zeusbrokers.lesliecaragent",
    "productName": "Leslie Car Agent",
    "artifactName": "Leslie-Car-Agent-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.js",
      "server.js",
      "src/**/*",
      "public/**/*",
      "logo.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/whatsapp-web.js/**/*",
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*",
      "node_modules/@puppeteer/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Leslie Car Agent",
      "runAfterFinish": true
    }
  },
  "overrides": {
    "puppeteer": "25.12.0"
  }
}
